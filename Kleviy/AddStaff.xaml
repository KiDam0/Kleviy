<Window x:Class="Kleviy.AddStaff"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kleviy"
        mc:Ignorable="d"
        Title="Профиль" 

        MouseDown="MovingWin"

        Height="700" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#7A92A9"
        BorderBrush="#7A92A9">
    <Grid>

        <!--Кнопки шапки-->

        <!--Минимизация-->

        <Button 
         x:Name="MinButton" 
         Content="-" 
         Click="MinButton_Click" 
         HorizontalAlignment="Left" 
         Margin="276,4,0,0" 
         Width="61" 
         Background="#5D6C7A" 
         RenderTransformOrigin="0.55,0.344" 
         Foreground="#DD000000" 
         BorderBrush="{x:Null}" 
         Height="32" 
         VerticalAlignment="Top" />

        <!--Закрытие-->

        <Button 
         x:Name="CloseButton" 
         Content="x" 
         Click="CloseButton_Click" 
         Margin="342,4,0,0" 
         Background="#2D4E6E" 
         RenderTransformOrigin="0.55,0.344" 
         Height="32" 
         VerticalAlignment="Top" 
         HorizontalAlignment="Left" 
         Width="48" 
         BorderBrush="{x:Null}" />
        <Border 
        Background="#7A92A9"
        BorderBrush="#7A92A9"
        BorderThickness="1"
        CornerRadius="5,5,5,5" Margin="10,58,10,22">

        </Border>
        <TextBox
          x:Name="SecondNameTextBox"
          materialDesign:HintAssist.HelperText="Введите фамилию"
          materialDesign:HintAssist.Hint="Фамилия" Margin="32,82,34,582" FontSize="16">
            <TextBox.Text>
                <Binding
          Path="Name"
          UpdateSourceTrigger="PropertyChanged">
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBox
        x:Name="NameTextBox"
        materialDesign:HintAssist.HelperText="Введите имя"
        materialDesign:HintAssist.Hint="Имя" Margin="32,145,34,519" FontSize="16">
            <TextBox.Text>
                <Binding
        Path="Name"
        UpdateSourceTrigger="PropertyChanged">
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBox
        x:Name="FirstNameTextBox"
        materialDesign:HintAssist.HelperText="Необязательно*"
        materialDesign:HintAssist.Hint="Отчество" Margin="32,214,34,450" FontSize="16">
            <TextBox.Text>
                <Binding
        Path="Name"
        UpdateSourceTrigger="PropertyChanged">
                </Binding>
            </TextBox.Text>
        </TextBox>
        <DatePicker
        Name="DatePicker"
        materialDesign:HintAssist.Hint="Дата рождения" Margin="32,281,34,0" VerticalAlignment="Top" Height="34" />
        <TextBox
        x:Name="LoginTextBox"
        materialDesign:HintAssist.HelperText="Логин сотрудника"
        materialDesign:HintAssist.Hint="Логин" Margin="32,332,34,332" FontSize="16">
            <TextBox.Text>
                <Binding
        Path="Name"
        UpdateSourceTrigger="PropertyChanged">
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBox
        x:Name="PasswordTextBox"
        materialDesign:HintAssist.HelperText="Пароль сотрудника"
        materialDesign:HintAssist.Hint="Пароль" Margin="32,408,34,256" FontSize="16">
            <TextBox.Text>
                <Binding
        Path="Name"
        UpdateSourceTrigger="PropertyChanged">
                </Binding>
            </TextBox.Text>
        </TextBox>
        <Button 
         x:Name="AddButton" 
         Content="Добавить сотрудника" 
         Click="AddButton_Click" 
         HorizontalAlignment="Left" 
         Margin="167,613,0,0" 
         Width="209" 
         Background="#F0D2A8" 
        BorderBrush="#A97F43" 
         RenderTransformOrigin="0.55,0.344" 
         Foreground="#DD000000"
         Height="50" 
         VerticalAlignment="Top" FontWeight="Bold" FontSize="16" />
    </Grid>
</Window>
